# Copy to .env and fill in your own values. .env is git-ignored. Never commit it.

# dev = Purolator sandbox (https://shipapi-sandbox.purolator.com)
# prod = production (https://shipapi.purolator.com)
PUROLATOR_ENV=dev

# OAuth client credentials issued to you by Purolator (Okta)
REST_ClientId=
REST_Secret=
REST_XApiKey=

# Billing accounts used in the request bodies
AccountNumber=
Different_AccountNumber=

# Optional: only if Purolator issued separate locator keys
# locatorXApiKey=
# xOriginVerify=

# Optional: PHP on Windows has no CA bundle. If HTTPS fails with an SSL error,
# download cacert.pem from https://curl.se/docs/caextract.html and point to it.
# PUROLATOR_CAINFO=C:\php\cacert.pem
